# ---------------------------------------------------------------------------
# Frontend environment variables
#
# Locally these live in .env.local (gitignored). On Vercel, add them under
# Project > Settings > Environment Variables instead -- .env.local is never
# committed, so the deployment has no fallback for these.
#
# IMPORTANT: every NEXT_PUBLIC_* value is inlined into the client bundle at
# BUILD time. Changing one requires a redeploy, not just a restart.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend on Railway, e.g.
# https://omnivoice-backend.up.railway.app
# No trailing slash -- endpoints are appended as `${API_URL}/api/...`.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL for the live translator.
#
# Optional: when unset it is derived from NEXT_PUBLIC_API_URL
# (https -> wss, http -> ws), which is what you want 99% of the time.
# Set it explicitly ONLY if the socket lives on a different host.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Use the in-browser mock backend instead of the real API. Keep false.
NEXT_PUBLIC_USE_MOCK_API=false