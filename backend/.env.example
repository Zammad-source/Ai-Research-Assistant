# ---------------------------------------------------------------------------
# Backend environment variables
#
# Copy to .env for local development:
#     cp .env.example .env
#
# On Railway these are NOT read from a file. Set each one under
# Service > Variables. Every value marked REQUIRED must be present or the app
# refuses to start (pydantic-settings raises on missing required fields).
# ---------------------------------------------------------------------------

# --- REQUIRED ---------------------------------------------------------------

# Groq: answer generation, query rewriting and all translation.
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Supabase: chat history persistence. Optional in practice -- if it is
# unreachable the app logs a warning and keeps serving requests.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# ElevenLabs: text-to-speech for /api/voice/speech and /voice/test-tts.
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Tavily: the web-search retrieval layer behind /api/research/query.
# Free tier: https://app.tavily.com
TAVILY_API_KEY=tvly_your_key_here

# --- OPTIONAL ---------------------------------------------------------------

# "development" | "production"
ENVIRONMENT=development

# Translation engine: "groq" (default, remote), "nllb" (local, needs torch +
# a 2.3 GB model -- will NOT fit on Railway's free tier), or "auto"
# (prefer Groq, fall back to local NLLB).
TRANSLATION_BACKEND=groq

# Local NLLB checkpoint, only read when TRANSLATION_BACKEND is nllb/auto.
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M

# Comma-separated browser origins allowed by CORS, e.g.
# CORS_ORIGINS=https://my-app.vercel.app
# Leave empty to allow any origin (fine locally, loose in production).
CORS_ORIGINS=

# Request ceiling per client IP, per minute. slowapi counts in memory, so the
# limit is per container -- reset whenever the service restarts.
RATE_LIMIT_PER_MINUTE=20

# Set to "false" to stop writing logs/app.log. File logging is disabled
# automatically when RAILWAY_ENVIRONMENT is set, since container filesystems
# are ephemeral and stdout is what Railway collects.
LOG_TO_FILE=true

# --- NOT SET LOCALLY -------------------------------------------------------
# Railway injects these automatically. Do not set them yourself.
# PORT=8000
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app